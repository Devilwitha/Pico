<Window x:Class="PicoSteuerung.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pico Steuerung" Height="820" Width="480" MinHeight="600" MinWidth="420"
        Background="{StaticResource HintergrundBrush}"
        FontFamily="Segoe UI"
        Loaded="MainWindow_Loaded"
        Closing="MainWindow_Closing">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Verbindungsleiste -->
        <Border Grid.Row="0" Background="{StaticResource KarteBrush}" CornerRadius="14" Padding="12" Margin="0,0,0,10">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="HostEingabe" Grid.Column="0" Margin="0,0,8,0" VerticalContentAlignment="Center"
                             ToolTip="Hostname oder IP-Adresse des Pico" />
                    <Button x:Name="VerbindenButton" Grid.Column="1" Content="Verbinden" Margin="0,0,8,0" Click="VerbindenButton_Click" />
                    <Button x:Name="SuchenButton" Grid.Column="2" Content="Automatisch suchen" Click="SuchenButton_Click" />
                </Grid>
                <TextBlock x:Name="GeraeteNameText" Text="" FontSize="14" FontWeight="Bold" Foreground="{StaticResource AkzentBrush}" Margin="2,10,0,0" />
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Ellipse x:Name="LivePunkt" Grid.Column="0" Width="10" Height="10" Fill="{StaticResource TextDimBrush}" Margin="2,0,8,0" />
                    <TextBlock x:Name="InfoZeile" Grid.Column="1" Text="Nicht verbunden" Foreground="{StaticResource TextDimBrush}" FontSize="12.5" VerticalAlignment="Center" />
                </Grid>
            </StackPanel>
        </Border>

        <TextBlock x:Name="SucheStatus" Grid.Row="1" Text="" FontSize="12" Foreground="{StaticResource TextDimBrush}" Margin="4,0,0,8" />

        <!-- Inhalt -->
        <TabControl x:Name="HauptTabs" Grid.Row="2" SelectionChanged="HauptTabs_SelectionChanged">

            <!-- ===================== Tab: Steuerung ===================== -->
            <TabItem Header="Steuerung">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,12,0,0">
                    <StackPanel>

                        <UniformGrid Columns="2" Rows="2" Margin="0,0,0,16">
                            <Button x:Name="AufButton" Content="&#8593; Auf" Margin="4" Padding="16"
                                    PreviewMouseLeftButtonDown="AufAbHalten_Down" PreviewMouseLeftButtonUp="AufAbHalten_Up"
                                    MouseLeave="AufAbHalten_Up" Tag="auf" />
                            <Button x:Name="AbButton" Content="&#8595; Ab" Margin="4" Padding="16"
                                    PreviewMouseLeftButtonDown="AufAbHalten_Down" PreviewMouseLeftButtonUp="AufAbHalten_Up"
                                    MouseLeave="AufAbHalten_Up" Tag="ab" />
                            <Button x:Name="StehenButton" Content="&#127917; Stehen" Margin="4" Padding="16" Click="StehenSitzen_Click" Tag="stehen" />
                            <Button x:Name="SitzenButton" Content="&#127919; Sitzen" Margin="4" Padding="16" Click="StehenSitzen_Click" Tag="sitzen" />
                        </UniformGrid>

                        <TextBlock x:Name="AktionStatus" Text="Bereit" Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,16" HorizontalAlignment="Center" />

                        <GroupBox>
                            <GroupBox.Header>
                                <Grid Width="380">
                                    <TextBlock Text="Automatik" FontWeight="SemiBold" HorizontalAlignment="Left" />
                                    <CheckBox x:Name="AutomatikToggle" HorizontalAlignment="Right" Checked="AutomatikToggle_Changed" Unchecked="AutomatikToggle_Changed" />
                                </Grid>
                            </GroupBox.Header>
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Sitzen (Min)" FontSize="11" Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,4" />
                                        <TextBox x:Name="SitzenMinEingabe" Text="90" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Stehen (Min)" FontSize="11" Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,4" />
                                        <TextBox x:Name="StehenMinEingabe" Text="30" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="Aktuelle Position" FontSize="11" Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,4" />
                                <ComboBox x:Name="StartPhaseAuswahl" SelectedIndex="0" Margin="0,0,0,10">
                                    <ComboBoxItem Content="Sitzen" Tag="sitzen" />
                                    <ComboBoxItem Content="Stehen" Tag="stehen" />
                                </ComboBox>
                                <Border Background="#14FFFFFF" CornerRadius="10" Padding="12">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock x:Name="AutomatikPhaseText" Text="Automatik" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AkzentBrush}" HorizontalAlignment="Center" />
                                        <TextBlock x:Name="AutomatikTimerText" Text="--:--" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,4,0,4" />
                                        <TextBlock x:Name="AutomatikSubText" Text="ausgeschaltet" FontSize="11" Foreground="{StaticResource TextDimBrush}" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox>
                            <GroupBox.Header>
                                <Grid Width="380">
                                    <TextBlock Text="Bewegungserkennung" FontWeight="SemiBold" HorizontalAlignment="Left" />
                                    <CheckBox x:Name="AnwesenheitToggle" IsChecked="True" HorizontalAlignment="Right" Checked="AnwesenheitToggle_Changed" Unchecked="AnwesenheitToggle_Changed" />
                                </Grid>
                            </GroupBox.Header>
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Abfrage (Sek.)" FontSize="11" Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,4" />
                                        <TextBox x:Name="AbfrageEingabe" Text="3" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Timeout (Min.)" FontSize="11" Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,4" />
                                        <TextBox x:Name="TimeoutEingabe" Text="10" />
                                    </StackPanel>
                                </Grid>
                                <Border Background="#14FFFFFF" CornerRadius="10" Padding="12">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock x:Name="AnwesenheitDistanzText" Text="-- cm" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AkzentBrush}" HorizontalAlignment="Center" />
                                        <TextBlock x:Name="AnwesenheitTimerText" Text="--:--" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,4,0,4" />
                                        <TextBlock x:Name="AnwesenheitSubText" Text="ausgeschaltet" FontSize="11" Foreground="{StaticResource TextDimBrush}" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Verlauf">
                            <StackPanel x:Name="VerlaufListe">
                                <TextBlock Text="Noch keine Aktionen" Foreground="{StaticResource TextDimBrush}" FontSize="12.5" HorizontalAlignment="Center" Margin="0,6" />
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Update">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="UpdateDateiName" Grid.Column="0" Text="Keine Datei gewaehlt" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <Button Grid.Column="2" Content="Datei waehlen..." Click="UpdateDateiWaehlen_Click" />
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="UpdateHochladenButton" Grid.Column="0" Content="Update hochladen" IsEnabled="False" Click="UpdateHochladen_Click" />
                                    <Button x:Name="UpdateNeustartButton" Grid.Column="2" Content="Neustart" Click="Neustart_Click" />
                                </Grid>
                                <TextBlock x:Name="UpdateStatus" Text="" FontSize="11.5" Foreground="{StaticResource TextDimBrush}" TextWrapping="Wrap" Margin="0,8,0,0" />
                            </StackPanel>
                        </GroupBox>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ===================== Tab: Einstellungen ===================== -->
            <TabItem Header="Einstellungen">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,20,0,0" MaxWidth="360" HorizontalAlignment="Center">
                        <TextBlock Text="Geraetename" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,14" />
                        <TextBlock Text="Anzeigename (zur eindeutigen Erkennung bei mehreren Picos)" FontSize="11" Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,4" TextWrapping="Wrap" />
                        <TextBox x:Name="GeraeteNameEingabe" Margin="0,0,0,10" />
                        <Button x:Name="NameSpeichernButton" Content="Namen speichern" Click="NameSpeichern_Click" />
                        <TextBlock x:Name="NameStatusText" Text="" FontSize="12.5" TextWrapping="Wrap" TextAlignment="Center" Margin="0,10,0,0" />

                        <Border Height="1" Background="{StaticResource RandBrush}" Margin="0,20,0,20" />

                        <TextBlock Text="WLAN" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,14" />
                        <Border x:Name="WlanHinweisBox" Background="#0AFFFFFF" CornerRadius="12" Padding="14" Margin="0,0,0,18">
                            <TextBlock x:Name="WlanHinweisText" Text="Lade Status..." TextWrapping="Wrap" TextAlignment="Center" FontSize="13" Foreground="{StaticResource TextDimBrush}" />
                        </Border>
                        <TextBlock Text="WLAN-Name (SSID)" FontSize="11" Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,4" />
                        <TextBox x:Name="WlanSsidEingabe" Margin="0,0,0,14" />
                        <TextBlock Text="WLAN-Passwort" FontSize="11" Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,4" />
                        <PasswordBox x:Name="WlanPasswortEingabe" Margin="0,0,0,18" />
                        <Button x:Name="WlanSpeichernButton" Content="Speichern &amp; neu starten" Click="WlanSpeichern_Click" />
                        <TextBlock x:Name="WlanStatusText" Text="" FontSize="12.5" TextWrapping="Wrap" TextAlignment="Center" Margin="0,12,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ===================== Tab: Dateien ===================== -->
            <TabItem Header="Dateien">
                <Grid Margin="0,16,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Listenansicht -->
                    <StackPanel x:Name="DateienListenAnsicht" Grid.Row="0" Grid.RowSpan="2">
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="DateiSucheEingabe" Grid.Column="0" ToolTip="Datei suchen..." TextChanged="DateiSuche_Changed" />
                            <Button Grid.Column="2" Content="+ Neu" Click="DateiNeu_Click" />
                        </Grid>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="520">
                            <StackPanel x:Name="DateiListe">
                                <TextBlock Text="Lade Dateien..." Foreground="{StaticResource TextDimBrush}" FontSize="12.5" HorizontalAlignment="Center" Margin="0,10" />
                            </StackPanel>
                        </ScrollViewer>
                        <TextBlock x:Name="DateiListeStatus" Text="" FontSize="12" Foreground="{StaticResource TextDimBrush}" Margin="0,8,0,0" HorizontalAlignment="Center" />
                    </StackPanel>

                    <!-- Editoransicht -->
                    <StackPanel x:Name="DateiEditorAnsicht" Grid.Row="0" Grid.RowSpan="2" Visibility="Collapsed">
                        <TextBlock Text="Dateiname" FontSize="11" Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,4" />
                        <TextBox x:Name="DateiNameEingabe" Margin="0,0,0,10" />
                        <TextBox x:Name="DateiInhaltEingabe" AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap"
                                 FontFamily="Consolas" FontSize="12.5" Height="420"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="DateiSpeichernButton" Grid.Column="0" Content="Speichern" Click="DateiSpeichern_Click" />
                            <Button x:Name="DateiAbbrechenButton" Grid.Column="2" Content="Abbrechen" Click="DateiAbbrechen_Click" />
                        </Grid>
                        <TextBlock x:Name="DateiEditorStatus" Text="" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0" HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </TabItem>

        </TabControl>
    </Grid>
</Window>
